# Runtime
# NODE_ENV: Accepted values: 'production', 'development', 'test'. Default: 'development'
NODE_ENV="production"
# SERVER_PORT: Accepted values: number. Default: 3000
SERVER_PORT="6969"

# PostgreSQL
# Docker Compose uses DATABASE_NAME and DATABASE_PASSWORD to create the
# internal DATABASE_URL for the backend container.
# DATABASE_NAME: string (used by docker-compose)
DATABASE_NAME="unistay-db"
# DATABASE_PASSWORD: string (used by docker-compose)
DATABASE_PASSWORD="change-this-postgres-password"
# DATABASE_URL: Required. Accepted values: string
DATABASE_URL="postgresql://postgres:change-this-postgres-password@db:5432/uni-stay-dn-db?schema=public"
# POSTGRES_PORT: number (mapped external port for docker-compose)
POSTGRES_PORT="3005"
# PGADMIN_DEFAULT_EMAIL: Required valid email string (used by docker-compose pgAdmin)
PGADMIN_DEFAULT_EMAIL="admin@unistay.com"
# PGADMIN_DEFAULT_PASSWORD: Required string (used by docker-compose pgAdmin)
PGADMIN_DEFAULT_PASSWORD="admin"
# PGADMIN_PORT: number (mapped external port for docker-compose pgAdmin)
PGADMIN_PORT="5050"

# JWT
# JWT_SECRET: Required. Accepted values: string
JWT_SECRET="change-this-to-a-long-random-secret"
# ACCESS_TOKEN_TTL_SECONDS: Required. Accepted values: positive integer
ACCESS_TOKEN_TTL_SECONDS="900"
# REFRESH_TOKEN_TTL_SECONDS: Required. Accepted values: positive integer
REFRESH_TOKEN_TTL_SECONDS="604800"

# Email OTP and password reset
# EMAIL_VERIFICATION_TTL: Required. Accepted values: number
EMAIL_VERIFICATION_TTL="120000"
# EMAIL_USER: Required. Accepted values: valid email string
EMAIL_USER="your-smtp-email@example.com"
# EMAIL_PASSWORD: Required. Accepted values: string
EMAIL_PASSWORD="your-smtp-app-password"

# Google OAuth
# GOOGLE_CLIENT_ID: Required. Accepted values: string
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
# GOOGLE_CLIENT_SECRET: Required. Accepted values: string
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Public frontend origin, without trailing slash.
# FRONTEND_URL: Required. Accepted values: valid URI string
FRONTEND_URL="https://unistay.dpdns.org"

# Redis
# REDIS_HOST: Required. Accepted values: string
REDIS_HOST="redis"
# REDIS_PORT: Required. Accepted values: number (internal port)
REDIS_PORT="6379"
# REDIS_PASSWORD: Required. Accepted values: string
REDIS_PASSWORD="change-this-redis-password"
# REDIS_EXTERNAL_PORT: number (mapped external port for docker-compose)
REDIS_EXTERNAL_PORT="3004"
# REDIS_MAXMEMORY: string with size unit (used by docker-compose Redis)
REDIS_MAXMEMORY="256mb"

# AI moderation
# GEMINI_API_KEY: Required. Accepted values: string
GEMINI_API_KEY="your-gemini-api-key"
# MOONDREAM_API_KEY: Required. Accepted values: string
MOONDREAM_API_KEY="your-moondream-api-key"