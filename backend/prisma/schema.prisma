// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum account_status {
  ACTIVE
  LOCKED
  SET_UP
  BANNED
}

enum account_role {
  ADMIN
  USER
  STUDENT
  HOST
}

enum provider {
  GOOGLE
  SYSTEM
}

// Models
model session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model email_verification {
  email     String    @id @unique
  code      String?
  expiresAt DateTime?
}

model user {
  id              String            @id @default(uuid())
  email           String            @unique @db.VarChar(255)
  hashedPassword  String?
  fullName        String            @db.VarChar(100)
  phone           String?           @unique @db.VarChar(15)
  dob             DateTime?
  gender          String?           @db.VarChar(10)
  avatarUrl       String?           @db.Text
  emailVerified   Boolean?          @default(false)
  phoneVerified   Boolean?          @default(false)
  provider        provider?
  status          account_status?   @default(LOCKED)
  roles           account_role[]    @default([USER])
  createdAt       DateTime          @default(now())
  student         student?
  hosts           host[]
  systemFeedbacks system_feedback[]
}

model district {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(100)
  wards ward[]
}

model ward {
  id           Int          @id @default(autoincrement())
  districtId   Int
  name         String       @db.VarChar(100)
  district     district     @relation(fields: [districtId], references: [id])
  universities university[]
}

model university {
  id          String    @id @db.VarChar(10)
  name        String    @db.VarChar(255)
  wardId      Int
  streetName  String    @db.VarChar(255)
  houseNumber String    @db.VarChar(50)
  ward        ward      @relation(fields: [wardId], references: [id])
  students    student[]
}

model student {
  studentId            String                  @id @default(uuid())
  total_post           Int                     @default(0)
  universityId         String
  university           university              @relation(fields: [universityId], references: [id])
  user                 user                    @relation(fields: [studentId], references: [id])
  studentEvaluateHosts student_evaluate_host[]
}

model host {
  hostId               String                  @id @default(uuid())
  isVerified           Boolean                 @default(false)
  avgStar              Float                   @default(-1)
  user                 user                    @relation(fields: [hostId], references: [id])
  studentEvaluateHosts student_evaluate_host[]
}

model student_evaluate_host {
  id          String   @id @default(uuid())
  studentId   String
  hostId      String
  numberStar  Int
  description String
  createdAt   DateTime @default(now())
  student     student  @relation(fields: [studentId], references: [studentId])
  host        host     @relation(fields: [hostId], references: [hostId])
}

model system_feedback {
  id          String   @id @default(uuid())
  userId      String
  numberStar  Int
  description String
  createdAt   DateTime @default(now())
  user        user     @relation(fields: [userId], references: [id])
}
